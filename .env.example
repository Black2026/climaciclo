# Exemplo sem credenciais. Preencher somente no ambiente correto do Lovable/Cloud.
# Variaveis publicaveis do cliente Supabase (nao coloque secrets aqui):
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Variaveis apenas de servidor, nunca com prefixo VITE_, nunca versionar os valores:
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY e CLIMACICLO_ENABLE_LEAD_SUBMISSION devem ser configuradas
# somente em ambiente seguro; este exemplo nao libera envios reais.
